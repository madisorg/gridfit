---
// /{brand}/ — one page per brand across both halves: the families with a Home Assistant / evcc route (#local)
// and every model of the brand on the grid lists (#grid), with anchors for the models that have no page.
import Base from "../../layouts/Base.astro";
import FamilyTable from "../../components/FamilyTable.astro";
import RegCell from "../../components/RegCell.astro";
import CellLegend from "../../components/CellLegend.astro";
import { REPO } from "../../lib/data";
import { COUNTRIES, RC, SNAP_DATE, trustOf } from "../../lib/registers";
import { BRANDS, localOf, familyOf, modelUrl, modelAnchor, nf, type Brand } from "../../lib/devices";

export function getStaticPaths() {
  return BRANDS.map((b) => ({ params: { brand: b.slug }, props: { b } }));
}
const { b } = Astro.props as { b: Brand };
const fams = b.families, models = b.models;
const local = fams.filter((f) => ["control", "read"].includes(localOf(f))).length;
const ctl = fams.filter((f) => localOf(f) === "control").length;
const listed = COUNTRIES.filter((c) => models.some((d) => d.cells[c]));
const groups = Object.keys(RC).map((c) => [c, models.filter((d) => d.cls === c)] as const).filter(([, g]) => g.length);
const matchedN = models.filter((d) => familyOf(d)).length;
const issue = `${REPO}/issues/new?template=fix-a-row.yml&title=${encodeURIComponent(b.name + ": ")}`;
---
<Base title={`${b.name}: local control with Home Assistant and evcc, and EU grid lists`} current={fams.length ? "/local/" : "/grid/"}
      description={`${b.name}: ${fams.length} product famil${fams.length === 1 ? "y" : "ies"} with a Home Assistant or evcc route (${local} local), and ${nf(models.length)} models on the grid-connection lists of ${listed.join(", ") || "none of the 7 lists read"}.`}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/local/">Local control</a><span aria-hidden="true">/</span><a href="/grid/">Grid lists</a></nav>
  <header class="head">
    <h1>{b.name}</h1>
    <p class="kind"><span>{fams.length} famil{fams.length === 1 ? "y" : "ies"} with a smart-home route, {local} local, {ctl} with control</span><span aria-hidden="true">·</span>
      <span>{nf(models.length)} model{models.length === 1 ? "" : "s"} on grid lists{listed.length ? ` (${listed.join(", ")})` : ""}</span></p>
    <p class="chips"><a href="#local">Local control</a><a href="#grid">Grid lists</a></p>
  </header>

  <div class="device">
    <section class="sec" id="local-sec" aria-labelledby="local">
      <header><h2 id="local">Local control with Home Assistant and evcc</h2><p>{fams.length ? `${fams.length} families` : `checked ${SNAP_DATE}`}</p></header>
      {fams.length ? <FamilyTable families={fams} showBrand={false} /> :
        <p class="prose">No Home Assistant core or HACS integration and no evcc template names {b.name} (checked {SNAP_DATE}). That is not “does not work” — it means no source we read covers the brand. <a href={issue}>Know one?</a></p>}
    </section>

    <section class="sec" id="grid-sec" aria-labelledby="grid">
      <header><h2 id="grid">Grid-connection lists</h2><p>{models.length ? `${nf(models.length)} models on ${listed.length} of ${COUNTRIES.length} lists · ${matchedN} belong to a family above` : `none of the ${COUNTRIES.length} lists read names ${b.name}`}</p></header>
      {models.length > 0 && (
        <>
          <p class="note">The list is the authority; this is a cross-reference. Empty = no matching entry found, never “not approved”.
            A model name links to its page when it is in two or more lists, or to its family. All rows read {SNAP_DATE}.</p>
          <CellLegend />
          {groups.map(([cls, g]) => (
            <section class="sec">
              <header><h3>{RC[cls]}</h3><p>{g.length}</p></header>
              <table class="xv">
                <thead><tr><th scope="col">Model</th>{COUNTRIES.map((c) => <th scope="col"><a href={`/grid/${c.toLowerCase()}/`}>{c}</a></th>)}<th scope="col" class="match">Match</th></tr></thead>
                <tbody>
                  {g.map((d) => {
                    const f = familyOf(d);
                    const url = f || d.page ? modelUrl(d) : "";
                    return (
                      <tr id={modelAnchor(d)}>
                        <td>{url ? <a href={url}>{d.model}</a> : d.model}{f && <span class="cls">{f.name}</span>}</td>
                        {COUNTRIES.map((c) => <RegCell c={c} cell={d.cells[c]} cls={d.cls} />)}
                        <td class="match">{trustOf(d)}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </section>
          ))}
          <p class="small muted">A small number after a symbol = the list has several rows for this model (variants, firmware versions).
            Something wrong? <a href={issue}>Fix a row</a>.</p>
        </>
      )}
    </section>
  </div>
</Base>
