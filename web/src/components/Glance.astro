---
// The glance bar: two rows that answer both questions above the fold on a phone — the local lens and the
// grid lens — always both, whichever way the reader came in.
import Status from "./Status.astro";
import Matrix from "./Matrix.astro";
import { COUNTRIES } from "../lib/registers";
import { LOCAL_WORD, type LocalState, type GridState } from "../lib/devices";
import type { Release } from "../lib/evidence";
import { subTiers } from "../lib/devices";
const { local, routes = [], cells, entries = {}, cls, seen, listDate, releases = [], kva = null } = Astro.props as
  { local: LocalState; routes?: string[]; cells: Record<string, GridState>; entries?: Record<string, any[]>; cls?: string; seen: string; listDate?: string; releases?: Release[]; kva?: number | null };
const subs = subTiers(cells, releases, kva);
const likely = Object.values(subs).filter((s) => s.tier === "D").length, possibly = Object.values(subs).filter((s) => s.tier === "K").length;
const mark = local === "control" ? "write" : local === "read" ? "local" : local === "cloud" ? "cloud" : "none";
const on = COUNTRIES.filter((k) => cells[k] === "listed" || cells[k] === "restricted");
const docCc = [...new Set(releases.flatMap((r) => r.countries))].filter((c) => !COUNTRIES.includes(c));
const gridWord = (on.length ? `fit in ${on.join(", ")}` : `on none of the ${COUNTRIES.length} lists read`) + (likely ? ` · off the list but likely in ${likely}` : "") + (possibly ? ` · possibly in ${possibly}` : "") + (docCc.length ? ` · by the maker's document in ${docCc.length} more countries` : "");
---
<div class="glance" role="group" aria-label="At a glance">
  <div><span class="k"><a href="#local">Local</a></span><Status kind={mark} label={LOCAL_WORD[local]} />
    {routes.length > 0 && <span class="muted">{routes.slice(0, 3).join(", ")}{routes.length > 3 ? ` +${routes.length - 3}` : ""}</span>}
    <span class="muted">· seen {seen}</span></div>
  <div><span class="k"><a href="#grid">Grid</a></span><Matrix cells={cells} entries={entries} cls={cls} rich={true} subs={subs} /><span class="muted">{gridWord}{listDate ? ` · lists dated up to ${listDate}` : ""}</span></div>
</div>
