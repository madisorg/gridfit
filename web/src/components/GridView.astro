---
// The grid view: one row per register model, filtered in place from /grid/index.json. The chosen countries are
// columns, never a filter: a model that is not on the list stays, with its own status — in a country with a list
// the list's word, in a country without one the maker's document, the type-A limit or what other EU lists say
// (web/src/lib/grid-filter.js; one status per model × country, so the status group is a partition and its counts
// add up — web/test/facets.mjs proves it). Status filters by the best answer among the chosen countries, or the
// worst with "every" ticked (the installer's question). Nothing chosen: every country the site covers (10).
// Used by /grid/ (no preset) and /grid/{cc}/ (that country preselected).
import CellLegend from "./CellLegend.astro";
import { BRANDS, KVA_BUCKETS, MPPT_OPTS, SPEC_BRANDS } from "../lib/devices";
import { IN_SCOPE } from "../lib/countries";
import { EVIDENCE_BRANDS } from "../lib/evidence";
import { LEGACY_COUNTS } from "../lib/legacy";
const { preset = "", id = "gv", kind = "", kindAt = "here" } = Astro.props as { preset?: string; id?: string; kind?: string; kindAt?: "here" | "top" };
const gridBrands = BRANDS.filter((b) => b.models.length);
// the status groups, best to worst (grid-filter.js ORDER); the glyph is the cell's, the word the legend's
// highest confidence first, always all shown (Madis 31.10): fit · likely · possibly · other procedure · unknown · not fit
const ST: [string, string, string, string][] = [
  ["Y", "cl-yes", "✓", "Fit: on the list"], ["C", "cl-cond", "✓", "Fit, with a condition or end date"], ["F", "cl-free", "✓", "Fit: nothing to approve for this kind of device"],
  ["D", "cl-doc", "✓", "Likely fit: the maker's document names the country"], ["K", "cl-else", "○", "Possibly fit: accepted on other EU lists"], ["B", "cl-type", "B", "Other procedure: over the type-A limit"],
  ["?", "cl-unk", "?", "Unknown: not confirmed"], ["-", "cl-none", "", "Unknown: not on the list"], ["X", "cl-no", "✕", "Not fit: refused, expired or not allowed"]];
const ROUTE: [string, string][] = [["W", "local control"], ["L", "local, read only"], ["C", "cloud only"], ["B", "brand route, model unconfirmed"], ["-", "not found"]];
const LO: Record<string, string> = { W: "Local control", L: "Local, read only", C: "Cloud only", B: "Brand route, model unconfirmed", "-": "No route found" };
---
<div class="layout gv" id={id} data-preset={preset} data-kind={kind}>
  <fieldset class="filters" id="xf">
    <legend>Narrow down</legend>
    <div class="cc" id="ccpick" role="group" aria-labelledby="ccpick-h">
      <span class="cc-h" id="ccpick-h">Countries</span>
      <div class="cc-t">{IN_SCOPE.map((c) => <label title={c.country}><input type="checkbox" name="c" value={c.cc} checked={c.cc === preset}><b>{c.cc}</b><span class="vh"> {c.country}</span></label>)}</div>
      <p class="small muted cc-none">None ticked: all {IN_SCOPE.length} as columns.</p>
    </div>
    {kindAt === "here" && <div class="kind" role="group" aria-label="Device kind">
      <button type="button" data-g="inv" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M6 12c1.5-3 3-3 4.5 0s3 3 4.5 0 2-2 3 0"/></svg>Inverters</button>
      <button type="button" data-g="ev" aria-pressed="false">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="11" height="16" rx="1"/><path d="M8.5 7h4M8.5 10h4M16 11h2.5v5a2 2 0 0 1-2 2H14"/><path d="M10.5 19v2"/></svg>Wallboxes</button>
    </div>}
    <fieldset class="st-pick" id="stpick"><legend id="st-h">Status</legend>
      {ST.map(([k, cls, glyph, word]) => <label data-k={k} hidden><input type="checkbox" name="st" value={k}> <span class={`cl ${cls}`} aria-hidden="true">{glyph}</span> <span class="w">{word}</span> <small class="n"></small></label>)}
      <label class="st-every" hidden><input type="checkbox" id="every"> in every chosen country</label>
    </fieldset>
    <label class="st-legacy"><input type="checkbox" id="legacy" value="1"> <span class="w">Include legacy models</span> <small class="n"></small></label>
    <label><span>Phases</span><select id="ph"><option value="">Any phases</option><option value="1">1-phase</option><option value="2">2-phase</option><option value="3">3-phase</option><option value="-">Phases not specified</option></select></label>
    <label><span>Rated power</span><select id="kva"><option value="">Any power</option>{KVA_BUCKETS.map(([k, w]) => <option value={k}>{w}</option>)}<option value="-">Power not specified</option></select></label>
    <label><span>MPPT</span><select id="mppt"><option value="">Any MPPT</option>{MPPT_OPTS.map(([k, w]) => <option value={k}>{w}</option>)}
      <option value="0">No MPPT: battery, AC inverter or wallbox</option><option value="-">MPPT not collected</option></select></label>
    <label><span>Brand</span><select id="brand"><option value="">All brands</option>{gridBrands.map((b) => <option value={b.name}>{b.name}</option>)}</select></label>
    <label><span>Other lists</span><select id="n"><option value="">Other lists: any</option><option value="0">Other lists: none</option><option value="1">Other lists: 1</option>
      <option value="2">Other lists: 2</option><option value="3">Other lists: 3 or more</option></select></label>
    <label><span>Local</span><select id="lo"><option value="">Any local route</option>{ROUTE.map(([k]) => <option value={k}>{LO[k]}</option>)}</select></label>
    <label><span>Home Assistant</span><select id="ha"><option value="">Home Assistant: any</option>{ROUTE.map(([k, w]) => <option value={k}>Home Assistant: {w}</option>)}</select></label>
    <label><span>evcc</span><select id="ev"><option value="">evcc: any</option>{ROUTE.map(([k, w]) => <option value={k}>evcc: {w}</option>)}</select></label>
    <label><span>Search</span><input id="q" type="search" autocomplete="off" spellcheck="false" placeholder="Model or brand"></label>
    <button type="button" id="reset" hidden>Clear filters</button>
  </fieldset>
  <div>
    <p class="count" id="xcount" aria-live="polite">Loading the table…</p>
    <p class="small muted ccnote" id="ccnote" hidden></p>
    <div id="xv"></div>
    <p><button type="button" id="more" class="xv-more" hidden>Show more</button></p>
    <noscript><p>The table needs JavaScript. Every model is also on its brand page.</p></noscript>
    <CellLegend />
    <p class="legend small"><span class="rs-key">Column head: <b>list</b> = the country has a public list · <b>cert.</b> = no list, the grid operator checks the maker's certificate · <b>—</b> = nothing to check for this class.</span>
      <span class="rs-key" id="sh-legend"><b>Local</b> = the best route on your network: <span class="st write">control</span> / <span class="st local">read</span> / <span class="st cloud">cloud</span> / <span class="st none">brand route</span>.
      <b>Smart home</b> = who talks to it, Home Assistant <span class="sh sh-W" role="img" aria-label="Home Assistant mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/><path d="M12 8.5v10M8.5 13.5l3.5 2.5 3.5-2.5"/></svg></span> then evcc <span class="sh sh-W" role="img" aria-label="evcc mark"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="12" height="11" rx="1.5"/><path d="M8 7V4M12 7V4M16 12h2.5a1.5 1.5 0 0 1 1.5 1.5V17"/><path d="M10 10l-2 3h4l-2 3"/></svg></span>,
      each mark coloured by its own route: <span class="sh sh-W" role="img" aria-label="local control"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/><path d="M12 8.5v10M8.5 13.5l3.5 2.5 3.5-2.5"/></svg></span> local control ·
      <span class="sh sh-L" role="img" aria-label="local, read only"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/><path d="M12 8.5v10M8.5 13.5l3.5 2.5 3.5-2.5"/></svg></span> local, read only · <span class="sh sh-C" role="img" aria-label="cloud only"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/><path d="M12 8.5v10M8.5 13.5l3.5 2.5 3.5-2.5"/></svg></span> cloud only ·
      <span class="sh sh-B" role="img" aria-label="brand route"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/><path d="M12 8.5v10M8.5 13.5l3.5 2.5 3.5-2.5"/></svg></span> brand route, model unconfirmed · empty = not found. Marks are GridFit's own glyphs, not the projects' logos.</span></p>
    <p class="small muted">Phases and rated power (kVA) come from the Austrian, Swedish and Belgian lists; where no list carries them the datasheet fills in, else “not specified”. No list carries MPPT counts: those are the makers' own datasheets,
      read so far for {SPEC_BRANDS.join(", ")} (model codes exactly as the sheet writes them); a battery, AC inverter or wallbox has no MPPT by its class; “not collected” means no sheet read yet, never “none”.
      “Fit by the maker's document” comes from the maker's own released-countries or certificate document, read so far for {EVIDENCE_BRANDS.join(", ") || "no brand yet"}. The list is the authority; this is a cross-reference.
      <b>Other lists</b> counts the read lists a model is on besides the countries you chose — a hint of what the maker has had certified where there is no list to check, never an approval.
      <b>Legacy</b> models are hidden unless included: expired or refused on every list that carries them ({LEGACY_COUNTS.A.toLocaleString("en")}), discontinued by the maker's own archive ({LEGACY_COUNTS.B.toLocaleString("en")}), or probably legacy — an entry older than six years, untouched, with a newer generation of the family on the lists ({LEGACY_COUNTS.C.toLocaleString("en")}); never an age guess. A search by model code shows them regardless; the model page gives the reason.</p>
  </div>
</div>

<script>
  import { IDS, cellCode, rowStatus, predicates, select, facet, positiveLists, rank } from "../lib/grid-filter.js";
  const root = document.querySelector<HTMLElement>(".gv")!;
  const $ = <T extends HTMLElement>(id: string) => root.querySelector(`#${id}`) as T;
  // the list's own word per cell letter; the hover and the aria-label
  const WORD: Record<string, string> = { L: "on the list", R: "on the list, with a condition", T: "on the list, time-limited", P: "not fit: the end date has passed",
    E: "not fit: expired", N: "not fit: the list says no", O: "on the list (see the list)", "-": "not on the list — the list may spell the model differently; never “not approved”" };
  const CL: Record<string, [string, string]> = { Y: ["cl-yes", "✓"], C: ["cl-cond", "✓"], F: ["cl-free", "✓"], D: ["cl-doc", "✓"], K: ["cl-else", "○"], B: ["cl-type", "B"], "?": ["cl-unk", "?"], "-": ["cl-none", ""], X: ["cl-no", "✕"] };
  const RULE: Record<string, string> = { list: "list", rule: "cert.", free: "—", banned: "not allowed", unknown: "?" };
  const MARK: Record<string, string> = { W: "local control", L: "local, read only", C: "cloud only", B: "brand route, model unconfirmed", "-": "not found" };
  const HA = `<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v9h13v-9"/><path d="M12 8.5v10M8.5 13.5l3.5 2.5 3.5-2.5"/></svg>`, EV = `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="7" width="12" height="11" rx="1.5"/><path d="M8 7V4M12 7V4M16 12h2.5a1.5 1.5 0 0 1 1.5 1.5V17"/><path d="M10 10l-2 3h4l-2 3"/></svg>`;
  const mark = (who: string, icon: string, m: string) => `<span class="sh sh-${m}" role="img" aria-label="${who}: ${MARK[m]}" title="${who}: ${MARK[m]}">${icon}</span>`;
  const LEVEL: Record<string, [string, string]> = { W: ["write", "control"], L: ["local", "read"], C: ["cloud", "cloud"], B: ["none", "brand route"], "-": ["none", "–"] };
  const best = (a: string, b: string) => "WLCB-".indexOf(a) <= "WLCB-".indexOf(b) ? a : b;
  const KIND: Record<string, string> = { inverter: "PV inverter", hybrid: "hybrid", battery: "battery", "plug-in": "plug-in", wallbox: "wallbox" };
  type Row = [number, string, string, string, string, string, string, string, number | null, number | null, string, string];
  type Idx = { read: string[]; countries: string[]; names: Record<string, string>; scope: Record<string, Record<string, string>>; limits: Record<string, { max_kw: number }>; how: string[]; notListed: Record<string, string>; brands: string[]; rows: Row[] };
  let data: Idx, hits: Row[] = [], shown = 0, g = root.dataset.kind || "", qt = 0;
  const PAGE = 100;
  const esc = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!);
  const nf = (n: number) => n.toLocaleString("en");
  const stBoxes = [...root.querySelectorAll<HTMLInputElement>('input[name="st"]')];
  const val = (id: string) => id === "st" ? stBoxes.filter((b) => b.checked).map((b) => b.value).join("") : id === "legacy" ? ($<HTMLInputElement>(id).checked ? "1" : "") : ($<HTMLInputElement>(id).value || "").trim();
  const boxes = [...root.querySelectorAll<HTMLInputElement>('input[name="c"]')];
  const sel = () => boxes.filter((b) => b.checked).map((b) => b.value);
  // the kind buttons sit in the table's own column, or in the page header (data-for names this view)
  const kinds = [...document.querySelectorAll<HTMLButtonElement>(`#${root.id} .kind button, .kind[data-for="${root.id}"] button`)];

  // the hover of one cell: the country, the status in words, and why
  function tip(r: Row, cc: string, code: string): string {
    const i = data.read.indexOf(cc), name = data.names[cc] ?? cc;
    if (i >= 0 && r[4][i] !== "-") return `${cc}: ${WORD[r[4][i]]}`;
    const st = i >= 0 ? "list" : data.scope[cc]?.[r[2]] ?? "unknown", brand = data.brands[r[0]];
    // the second level of a list country: not on the list, then what the country does with such a model (its profile's words)
    const off = i >= 0 ? `not on the list — ` : "";
    const then = i >= 0 ? (data.notListed[cc] ?? "the grid operator decides outside the list") : st === "rule" ? `${name} has no list: the grid operator checks the maker's certificate` : `${name}'s list is not read yet — check the model there`;
    if (code === "D") return `${cc}: ${off}likely fit: ${brand} publishes a release table or a certificate naming ${name}'s standard for this model; ${then} (the model page shows the document)`;
    if (code === "K") { const on = positiveLists(r, data, cc); return `${cc}: ${off}possibly fit: accepted on ${on.length} other EU list${on.length === 1 ? "" : "s"} (${on.join(", ")}) — nothing checked here; ${then}`; }
    if (code === "B") return `${cc}: ${off}over the type-A limit in ${name} (${data.limits[cc].max_kw} kW) — type B, a procedure of its own`;
    if (i >= 0) return `${cc}: not on the list, nothing known — its listings elsewhere are expired or refused; ${then}; the list may also spell the model differently, never “not approved”`;
    if (code === "F") return `${cc}: fit — nothing to approve: ${name} has no list and no rule for this kind of device`;
    if (code === "?") return `${cc}: not confirmed whether ${name} lists or otherwise gates this class`;
    if (code === "X") return `${cc}: not fit — ${name} does not allow this kind of device`;
    return `${cc}: nothing known — its listings elsewhere are expired or refused; ${noList}`;
  }

  function apply() {
    const cs = sel(), readSel = cs.filter((c) => data.read.includes(c)), ccs = cs.length ? cs : data.countries;
    ($("every").closest("label") as HTMLElement).hidden = cs.length < 2;
    const every = cs.length >= 2 && $<HTMLInputElement>("every").checked;
    ($("mppt").closest("label") as HTMLElement).hidden = g === "ev";
    if (g === "ev") $<HTMLSelectElement>("mppt").value = "";
    const cur0 = val("q").toLowerCase();
    const ctx = { ccs, every, readSel, q: cur0 };
    const T = predicates(data, ctx);
    const cur: Record<string, string> = Object.fromEntries(IDS.map((id) => [id, id === "q" ? val(id).toLowerCase() : val(id)]));
    hits = select(data, cur, g, T);
    // a chosen country sorts its best answers first; otherwise the index order (most lists first)
    if (cs.length) hits = hits.map((r, i) => [rank(rowStatus(r, ccs, false, data)), i, r] as [number, number, Row]).sort((a, b) => a[0] - b[0] || a[1] - b[1]).map((x) => x[2]);
    // every option says how many models it would leave with the other filters as they stand; a partition, so they add up
    const rcls = g === "ev" ? "wallbox" : "inverter";
    const scopes = new Set(ccs.map((c) => (data.read.includes(c) ? "list" : data.scope[c]?.[rcls] ?? "unknown")));
    for (const id of IDS) {
      if (id === "q") continue;
      const base = select(data, cur, g, T, id), counts = facet(id, base, data, ctx);
      if (id === "legacy") { $("legacy").parentElement!.querySelector(".n")!.textContent = `(${nf(counts.get("1") ?? 0)})`; continue; }
      if (id === "st") {
        stBoxes.forEach((b) => {
          const n = counts.get(b.value) ?? 0, lab = b.parentElement!;
          lab.hidden = false;
          lab.classList.toggle("zero", !n);
          lab.querySelector(".n")!.textContent = `(${nf(n)})`;
          // a list country's second level says so in the label
          const onlyList = scopes.has("list") && scopes.size === 1, mixed = scopes.has("list") && scopes.size > 1;
          const base: Record<string, string> = onlyList || mixed ? { D: "likely fit: the maker's document names the country", K: "possibly fit: accepted on other EU lists", B: "other procedure: over the type-A limit", "-": "nothing known" }
            : { D: "Likely fit: the maker's document names the country", K: "Possibly fit: accepted on other EU lists", B: "Other procedure: over the type-A limit", "-": "Unknown: nothing known" };
          if (b.value in base) lab.querySelector(".w")!.textContent = (onlyList ? "Not on the list — " : mixed ? "Not on the list / " : "") + (b.value === "-" && onlyList ? "nothing known" : b.value === "-" && mixed ? "nothing known" : base[b.value]);
        });
        continue;
      }
      for (const o of $<HTMLSelectElement>(id).options) {
        const n = o.value ? counts.get(o.value) ?? 0 : base.length;
        o.dataset.l ??= o.textContent!;
        o.textContent = `${o.dataset.l} (${nf(n)})`;
        o.hidden = o.disabled = !n && !!o.value && !o.selected;
      }
    }
    const st = cur.st;
    let line = `<b>${nf(hits.length)}</b> ${hits.length === 1 ? "model" : "models"}`;
    if (st) line += ` by status in ${ccs.join(every ? " and " : " or ")}`;
    else if (cs.length === 1) {
      const c = cs[0], by = (k: string) => hits.filter((r) => cellCode(r, c, data) === k).length;
      line += data.read.includes(c) ? ` · in ${c}: ${nf(by("Y") + by("C"))} on the list; off the list ${nf(by("D"))} likely, ${nf(by("K"))} possibly fit` : ` · in ${c}: ${nf(by("D"))} by the maker's document, ${nf(by("K"))} accepted on other EU lists`;
    }
    const hiddenLegacy = cur.legacy || cur0 ? 0 : select(data, { ...cur, legacy: "1" }, g, T).length - hits.length;
    if (hiddenLegacy) line += ` · ${nf(hiddenLegacy)} legacy ${hiddenLegacy === 1 ? "model" : "models"} hidden — <a href="#" id="showlegacy">include</a>`;
    $("xcount").innerHTML = line;
    $("xcount").querySelector("#showlegacy")?.addEventListener("click", (e) => { e.preventDefault(); $<HTMLInputElement>("legacy").checked = true; apply(); });
    // a chosen country without a list gets one sentence on how its cells are decided
    const notes = cs.slice(0, 2).map((c) => {
      const name = data.names[c] ?? c, s = data.read.includes(c) ? "read" : data.scope[c]?.[rcls], how = data.how.includes(c) ? ` <a href="/grid/${c.toLowerCase()}/#how">How it works in ${name}</a>.` : "";
      if (s === "read") return `<b>${name}</b>: green is the list's own answer. A model <b>off the list</b> gets a second level in amber — <span class="cl cl-doc" aria-hidden="true">✓</span> likely, the maker's document names ${name}; <span class="cl cl-else" aria-hidden="true">○</span> possibly, accepted on other EU lists — because ${data.notListed[c] ?? "the grid operator decides outside the list"}.${how}`;
      if (s === "rule") return `<b>${name}</b> has no public list: the grid operator checks the maker's certificate. Amber is the operator's call: <span class="cl cl-doc" aria-hidden="true">✓</span> likely — the maker's own document names ${name}; <span class="cl cl-else" aria-hidden="true">○</span> possibly — accepted on other EU lists, nothing checked here; <span class="cl cl-type" aria-hidden="true">B</span> over the type-A limit, another procedure.${how}`;
      if (s === "list") return `<b>${name}</b> publishes a list GridFit has not read yet — check the model there. Meanwhile amber: <span class="cl cl-doc" aria-hidden="true">✓</span> likely — the maker's document names ${name}, <span class="cl cl-else" aria-hidden="true">○</span> possibly — accepted on other EU lists.${how}`;
      if (s === "free") return `<b>${name}</b> has no list and no rule for ${g === "ev" ? "wallboxes" : "this kind of device"}: nothing to approve, so every model is fit.${how}`;
      if (s === "banned") return `<b>${name}</b> does not allow ${g === "ev" ? "wallboxes" : "this kind of device"} to be connected.${how}`;
      return `<b>${name}</b>: whether a list or a rule applies is not confirmed yet.${how}`;
    });
    $("ccnote").innerHTML = notes.join(" ");
    $("ccnote").hidden = !notes.length;
    shown = 0;
    $("xv").innerHTML = '<table class="xv"><thead><tr><th scope="col">Model</th>' +
      ccs.map((k) => `<th scope="col"><a href="/grid/${k.toLowerCase()}/" title="${esc(data.names[k] ?? k)}">${k}</a><span class="rule">${RULE[data.scope[k]?.[rcls] ?? "unknown"]}</span></th>`).join("") +
      '<th scope="col" class="num">Lists</th><th scope="col" class="sp">Ph</th><th scope="col" class="sp">kVA</th><th scope="col" class="sp mp">MPPT</th><th scope="col" class="lo">Local</th><th scope="col" class="lo">Smart home</th></tr></thead><tbody id="xb"></tbody></table>';
    IDS.forEach((id) => $(id === "st" ? "stpick" : id).classList.toggle("on", !!val(id)));
    $("legacy").parentElement!.classList.toggle("on", !!val("legacy"));
    kinds.forEach((k) => k.setAttribute("aria-pressed", String(k.dataset.g === g)));
    const presetOnly = cs.length === 1 && cs[0] === root.dataset.preset;
    $("reset").hidden = !IDS.some((id) => val(id)) && g === (root.dataset.kind || "") && (!cs.length || presetOnly) && !every;
    document.body.dataset.g = g;
    more();
    const p = new URLSearchParams();
    if (cs.length && !presetOnly) p.set("c", cs.join(","));
    if (g && g !== root.dataset.kind) p.set("g", g);
    if (every) p.set("every", "1");
    IDS.forEach((id) => val(id) && p.set(id, val(id)));
    history.replaceState(null, "", p.toString() ? "?" + p : location.pathname);
  }

  function more() {
    const cs = sel(), ccs = cs.length ? cs : data.countries;
    const html = hits.slice(shown, shown + PAGE).map((r) => {
      const cells = ccs.map((c) => {
        const code = cellCode(r, c, data), [cls, glyph] = CL[code], t = tip(r, c, code);
        return `<td class="c"><span class="cl ${cls}" role="img" aria-label="${esc(t)}" title="${esc(t)}">${glyph}</span></td>`;
      }).join("");
      const nl = r[4].replace(/-/g, "").length;
      const mp = r[9] !== null ? (r[9] === 0 ? '<span class="muted">none</span>' : String(r[9])) : r[2] === "battery" || r[2] === "wallbox" ? '<span class="muted" title="no MPPT: battery, AC inverter or wallbox">none</span>' : '<span class="muted" title="not collected">–</span>';
      const leg = r[11] ? `<span class="tag tag-legacy" title="${r[11] === "C" ? "probably legacy: an older generation" : r[11] === "B" ? "legacy: discontinued by the maker" : "legacy: expired or refused on every list"}">${r[11] === "C" ? "legacy?" : "legacy"}</span>` : "";
      return `<tr${r[11] ? ' class="legacy"' : ""}><td><a href="${r[3]}"><span class="b">${esc(data.brands[r[0]])}</span>&nbsp;${esc(r[1])}</a><span class="cls">${KIND[r[2]]}</span>${leg}</td>${cells}` +
        `<td class="num">${nl}</td><td class="sp">${r[7] || '<span class="muted">–</span>'}</td><td class="sp num">${r[8] === null ? '<span class="muted">–</span>' : r[8]}</td><td class="sp num mp">${mp}</td><td class="lo"><span class="st ${LEVEL[best(r[5][0], r[5][1])][0]}">${LEVEL[best(r[5][0], r[5][1])][1]}</span></td><td class="lo shc">${mark("Home Assistant", HA, r[5][0])}${mark("evcc", EV, r[5][1])}</td></tr>`;
    }).join("");
    $("xb").insertAdjacentHTML("beforeend", html);
    shown = Math.min(shown + PAGE, hits.length);
    $("more").hidden = shown >= hits.length;
    $("more").textContent = `Show more (${nf(hits.length - shown)} left)`;
  }

  fetch("/grid/index.json").then((r) => r.json()).then((d: Idx) => {
    data = d;
    const init = new URLSearchParams(location.search);
    if (init.get("c")) { const want = new Set(init.get("c")!.split(",")); boxes.forEach((b) => (b.checked = want.has(b.value))); }
    else if (root.dataset.preset) boxes.forEach((b) => (b.checked = b.value === root.dataset.preset));
    if (init.get("g") === "inv" || init.get("g") === "ev") g = init.get("g")!;
    $<HTMLInputElement>("every").checked = !!init.get("every");
    $("every").addEventListener("change", apply);
    IDS.forEach((id) => {
      if (id === "st") { const want = init.get("st") ?? ""; stBoxes.forEach((b) => { b.checked = want.includes(b.value); b.addEventListener("change", apply); }); return; }
      const el = $<HTMLInputElement>(id);
      if (id === "legacy") { el.checked = !!init.get("legacy"); el.addEventListener("change", apply); return; }
      if (init.get(id)) el.value = init.get(id)!;
      el.addEventListener(id === "q" ? "input" : "change", id === "q" ? () => { clearTimeout(qt); qt = setTimeout(apply, 120); } : apply);
    });
    boxes.forEach((b) => b.addEventListener("change", apply));
    // with a default kind the choice is one or the other, never "both"; without one a second click shows every kind
    kinds.forEach((k) => k.addEventListener("click", () => { g = g === k.dataset.g && !root.dataset.kind ? "" : k.dataset.g!; apply(); }));
    $("reset").addEventListener("click", () => { IDS.forEach((id) => id !== "st" && id !== "legacy" && ($<HTMLInputElement>(id).value = "")); $<HTMLInputElement>("legacy").checked = false; stBoxes.forEach((b) => (b.checked = false)); g = root.dataset.kind || ""; boxes.forEach((b) => (b.checked = b.value === root.dataset.preset)); $<HTMLInputElement>("every").checked = false; apply(); });
    $("more").addEventListener("click", more);
    apply();
  });
</script>
