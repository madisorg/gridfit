{
  "name": "gridfit-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python ../tools/site_data.py && python ../tools/specs/build.py && python ../tools/check/run.py && astro telemetry disable && astro build",
    "dev": "astro dev --port 8396",
    "test": "node test/facets.mjs && python ../tools/check/run.py --fixture ../tools/check/fixtures/gr --out .data/checks-fixture.json && node test/checks.mjs"
  },
  "dependencies": {
    "astro": "7.4.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@fontsource/archivo-narrow": "5.3.0",
    "@fontsource/barlow-semi-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-condensed": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@fontsource/source-sans-3": "5.2.8"
  }
}
