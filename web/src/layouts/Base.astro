---
import "../styles/site.css";
import { SITE, TITLE, REPO, data } from "../lib/data";
// the two faces every page paints first: preloaded so text does not reflow when they arrive
import textFont from "../fonts/ibm-plex-sans-latin-400-normal.woff2?url";
import headFont from "../fonts/barlow-semi-condensed-latin-600-normal.woff2?url";
interface Props { title?: string; description?: string; current?: string; noindex?: boolean }
const { title, description, current, noindex = false } = Astro.props;
const analytics = process.env.GRIDFIT_ANALYTICS ?? "";
const desc = description ?? "Two questions per inverter, home battery and wallbox: does it work locally with Home Assistant and evcc (read or control), and which EU grid-connection lists carry the model. Open data, every row linked to its source.";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
// both lenses in the main menu, always
const nav = [["/local/", "Local control"], ["/grid/", "Grid lists"], ["/changes/", "Changes"], ["/about/", "How we know"]];
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title ? `${title} — ${SITE}` : `${SITE} — ${TITLE}`}</title>
<meta name="description" content={desc}>
{noindex && <meta name="robots" content="noindex,follow">}
{canonical && <link rel="canonical" href={canonical}>}
<meta property="og:type" content="website">
<meta property="og:site_name" content={SITE}>
<meta property="og:title" content={title ?? `${SITE} — ${TITLE}`}>
<meta property="og:description" content={desc}>
{canonical && <meta property="og:url" content={canonical}>}
{Astro.site && <meta property="og:image" content={new URL("/og.png", Astro.site).href}>}
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content={Astro.site ? "summary_large_image" : "summary"}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preload" href={textFont} as="font" type="font/woff2" crossorigin>
<link rel="preload" href={headFont} as="font" type="font/woff2" crossorigin>
<meta name="color-scheme" content="light dark">
{analytics.startsWith("plausible:") && <script is:inline defer data-domain={analytics.split(":")[1]} src="https://plausible.io/js/script.js"></script>}
{analytics.startsWith("cloudflare:") && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analytics.split(":")[1] })}></script>}
<slot name="head" />
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="mark" href="/">{SITE}</a>
    <nav class="nav" aria-label="Site">
      {nav.map(([href, label]) => <a href={href} aria-current={current === href ? "page" : undefined}>{label}</a>)}
      <a class="fix" href={`${REPO}/issues/new/choose`}>Fix a row</a>
    </nav>
  </div>
</header>
<main>
  <div class="wrap"><slot /></div>
</main>
<footer class="foot">
  <div class="wrap">
    <div class="legal">
      <p>Built only from open sources: <a href="https://github.com/home-assistant/core">Home Assistant core</a> (Apache-2.0),
      the <a href="https://hacs.xyz/">HACS</a> default list and integration manifests, <a href="https://github.com/evcc-io/evcc">evcc</a> templates (MIT)
      and seven public grid-connection lists (AT, BE, CZ, EE, NL, PL, SE). Last checked {data.seen}.</p>
      <p>An empty cell means “not found”, never “does not work” or “not approved”. Firmware updates open and close local access;
      check the integration's own page before you buy, and your installer before software changes export limits or charges a battery from the grid.
      Independent project — not affiliated with the Open Home Foundation, Nabu Casa, evcc, HACS, any manufacturer or grid operator; names are used only to say what works with what.</p>
    </div>
    <p>Dataset <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
      (<a href={`${REPO}/blob/main/data/dataset/rows.csv`}>CSV</a>, <a href={`${REPO}/blob/main/data/dataset/rows.json`}>JSON</a>) ·
      code MIT · <a href={REPO}>corrections on GitHub</a> · <a href="/llms.txt">llms.txt</a> · no cookies.</p>
  </div>
</footer>
</body>
</html>
