---
// /grid/ — the grid lens as a query: one row per register model, countries as an AND multi-select.
import Base from "../../layouts/Base.astro";
import GridView from "../../components/GridView.astro";
import Timeline from "../../components/Timeline.astro";
import Ext from "../../components/Ext.astro";
import { devices, COUNTRIES, REGS, META, LOG, NOT_READ, SNAP_DATE, regsOf } from "../../lib/registers";
import { BRANDS, nf } from "../../lib/devices";
import { COUNTRIES_ALL, LIST_WORD } from "../../lib/countries";

const shown = devices.filter((d) => !d.unmatched);
const multi = shown.filter((d) => d.n >= 2).length;
const counts = Object.fromEntries(COUNTRIES.map((c) => [c, shown.filter((d) => d.cells[c]).length]));
const e = LOG[0];
const dates = Object.keys(META).map((r) => ({ label: `${r} — ${REGS[r]?.short ?? r}`, href: REGS[r]?.url, date: META[r].source_date || SNAP_DATE, kind: "reg" as const }));
const byFlag = (flag: string) => COUNTRIES_ALL.filter((c) => c.list === flag && !COUNTRIES.includes(c.cc));
const gridBrands = BRANDS.filter((b) => b.models.length);
---
<Base title="Is it fit for the grid? EU grid-connection lists, model by model" current="/grid/"
      description={`${nf(shown.length)} inverters, hybrids, batteries, plug-in units and wallboxes across ${COUNTRIES.length} national grid-connection lists read in full and ${COUNTRIES_ALL.length} EU+ countries described: pick your countries, phases and power, see each list's own status.`}>
  <section class="ask" aria-labelledby="h">
    <h1 id="h">Is it fit for the grid in your country?</h1>
    <p class="lede">Pick one country, or several: the table keeps the models that are on <em>every</em> selected list and shows, for a country without a list,
      what applies there. {nf(shown.length)} models from {COUNTRIES.length} lists read in full, {nf(multi)} of them on two or more; phases and rated power where a list carries them;
      the <strong>Smart home</strong> column is whether Home Assistant or evcc talks to the model on your network (<a href="/local/">that view</a>).</p>
    <p class="note"><strong>The list is the authority; this is a cross-reference.</strong> An empty cell means no matching entry was found — the model may be
      listed under another name, or the list may not cover it. It never means “not approved”. Check the list itself before you install.</p>
    <p class="facts"><span><b>{nf(shown.length)}</b> models</span><span><b>{COUNTRIES.length}</b> lists read</span><span><b>{COUNTRIES_ALL.length}</b> countries</span>
      <span>lists dated up to <b>{Object.values(META).map((m) => m.source_date || "").sort().pop()}</b></span><span>read <b>{SNAP_DATE}</b></span></p>
  </section>

  <GridView />

  <section class="sec" aria-labelledby="lists-h">
    <header><h2 id="lists-h">The lists read</h2><p>One per country; the list is dated by its publisher.</p></header>
    <div class="lists">
      {COUNTRIES.map((c) => {
        const regs = regsOf(c);
        return (
          <article class="panel">
            <h3><a href={`/grid/${c.toLowerCase()}/`}>{c} — {REGS[c].country}</a></h3>
            <dl class="facts-dl">
              <dt>List</dt><dd>{regs.map((r, i) => <>{i > 0 && "; "}<Ext href={REGS[r].url}>{REGS[r].name}</Ext></>)}</dd>
              <dt>List dated</dt><dd>{regs.map((r) => META[r]?.source_date ?? "—").join(", ")}</dd>
              <dt>Models here</dt><dd>{nf(counts[c])}</dd>
              <dt>We show</dt><dd>{REGS[c].use}</dd>
            </dl>
          </article>
        );
      })}
    </div>
  </section>

  <section class="sec" aria-labelledby="cc-h">
    <header><h2 id="cc-h">The other {COUNTRIES_ALL.length - COUNTRIES.length} countries</h2><p>From the EU+ grid-connection table; each country page says what applies per device class.</p></header>
    {["yes", "partial", "no"].map((flag) => byFlag(flag).length > 0 && (
      <p class="small"><b>{LIST_WORD[flag as "yes"]}{flag === "yes" ? ", not read yet" : ""}:</b>{" "}
        {byFlag(flag).map((c, i) => <>{i > 0 && ", "}<a href={`/grid/${c.cc.toLowerCase()}/`}>{c.country}</a></>)}</p>
    ))}
    <h3>Not read (yet)</h3>
    <ul class="prose small">{NOT_READ.map(([cc, country, name, link, why]) => <li><strong>{cc}</strong> {country} — <a href={link}>{name}</a>: {why}.</li>)}</ul>
  </section>

  <section class="sec" aria-labelledby="fresh-h">
    <header><h2 id="fresh-h">How fresh each list is</h2><p>The date each publisher put on its list. Last 12 months.</p></header>
    <Timeline items={[...dates, { label: "Downloaded by GridFit", date: SNAP_DATE, kind: "check" as const }]} end={SNAP_DATE} />
    <p class="small">Latest change: {e.date} — {e.baseline ? e.note : Object.entries(e.registers).map(([r, x]: any) => `${r} +${x.added.length} / −${x.removed.length} / ${x.changed.length} changed`).join(" · ") || "no changes"}
      — <a href="/changes/">all changes</a>.</p>
  </section>

  <section class="sec" aria-labelledby="br-h">
    <header><h2 id="br-h">Brands</h2><p>{gridBrands.length}</p></header>
    <p class="brand-list">{gridBrands.map((b) => <a href={`/${b.slug}/#grid`}>{b.name} <span class="muted">{b.models.length}</span></a>)}</p>
  </section>
</Base>
