---
// One list cell in a model table (brand page, device page): the three-answer Cell with the row's detail in the hover.
import Cell from "./Cell.astro";
import { stateOfCells, scopeState, type GridState } from "../lib/devices";
import type { Entry } from "../lib/registers";
const { c, cell, cls, rich = false } = Astro.props as { c: string; cell?: Entry[]; cls: string; rich?: boolean };
const state: GridState = cell?.length ? stateOfCells(cell) : scopeState(c, cls);
---
<td class="c"><Cell cc={c} state={state} entries={cell ?? []} cls={cls} rich={rich} />{cell && cell.length > 1 && <sup class="muted">{cell.length}</sup>}</td>
