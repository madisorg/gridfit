---
// Dense family table: one row per product family. Home page and brand pages use the same rows.
import { CLASS, summary, regCells, familyUrl, type Family } from "../lib/data";
import Status from "./Status.astro";
import Matrix from "./Matrix.astro";
const { families, showBrand = true, id } = Astro.props as { families: Family[]; showBrand?: boolean; id?: string };
---
<table class="tbl" id={id}>
  <thead><tr>
    <th scope="col">Product family</th><th scope="col">Class</th><th scope="col">Home Assistant</th>
    <th scope="col">evcc</th><th scope="col">Local control</th><th scope="col">Grid registers</th>
    <th scope="col" class="num">Register models</th>
  </tr></thead>
  <tbody>
  {families.map((f) => {
    const s = summary(f);
    const cells = regCells(f);
    return (
      <tr data-b={f.brand} data-c={f.class} data-n={s.conn.join(" ")} data-ha={s.ha} data-ev={s.evcc}
          data-w={s.control ? "1" : "0"} data-r={Object.keys(cells).filter((k) => cells[k] === "listed" || cells[k] === "restricted").join(" ")}>
        <td class="fam"><a href={familyUrl(f)}>{showBrand && <span class="b">{f.brand}</span>}{f.name}</a></td>
        <td>{CLASS[f.class]}</td>
        <td data-l="HA"><Status kind={s.ha} /></td>
        <td data-l="evcc"><Status kind={s.evcc} /></td>
        <td>{s.control ? <Status kind="write" /> : <Status kind="read" label={s.ha === "none" && s.evcc === "none" ? "not known" : "read only"} />}</td>
        <td class="wide"><Matrix cells={cells} titled={false} /></td>
        <td class="num" data-l="models">{f.models.length || "–"}</td>
      </tr>
    );
  })}
  </tbody>
</table>
