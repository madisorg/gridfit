---
import Base from "../../../layouts/Base.astro";
import { REGS, LOG, COUNTRIES } from "../../../lib/registers";
import { REPO } from "../../../lib/data";
const FIELD: Record<string, string> = { status: "status", fw: "firmware", valid: "end date" };
---
<Base title="What changed in the EU grid registers" current="/registers/"
      description={`Which inverters, batteries and chargers were added to, dropped from or changed in the grid-connection lists of ${COUNTRIES.join(", ")}, refresh by refresh.`}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/registers/">Grid registers</a></nav>
  <header class="head">
    <h1>What changed in the lists</h1>
    <p class="prose muted">Each refresh downloads every list again and compares it with the previous one: models added, models dropped, and a changed
      status word, firmware or end date. None of the lists publishes this itself. Dropped models are worth a look before you buy: a model can leave
      a list because its certificate expired, was replaced by a newer firmware, or was renamed. Raw history:
      <a href={`${REPO}/blob/main/data/registers/changelog.json`}>changelog.json</a>.</p>
  </header>
  {LOG.map((e) => (
    <section class="sec" id={e.date}>
      <header><h2 class="code">{e.date}</h2>{!e.baseline && <p>compared with {e.previous}</p>}</header>
      {e.baseline && <p>{e.note}</p>}
      {Object.entries(e.registers).map(([r, x]: [string, any]) => (
        <div class="panel" id={`${e.date}-${r}`}>
          <h3>{REGS[r].short}</h3>
          <p class="small muted">list dated {x.previous_source_date || "—"} → {x.source_date || "—"} · {x.added.length} added · {x.removed.length} removed · {x.changed.length} changed</p>
          {x.added.length > 0 && <details class="more"><summary>Added ({x.added.length})</summary><ul class="small">{x.added.slice(0, 500).map(([b, m, s]: string[]) => <li>{b} <span class="code">{m}</span> — {s}</li>)}</ul></details>}
          {x.removed.length > 0 && <details class="more"><summary>Removed ({x.removed.length})</summary><ul class="small">{x.removed.slice(0, 500).map(([b, m, s]: string[]) => <li>{b} <span class="code">{m}</span> — was {s}</li>)}</ul></details>}
          {x.changed.length > 0 && <details class="more"><summary>Changed ({x.changed.length})</summary><ul class="small">{x.changed.slice(0, 500).map(([b, m, f, o, n]: string[]) => <li>{b} <span class="code">{m}</span> — {FIELD[f]}: {o} → {n}</li>)}</ul></details>}
        </div>
      ))}
      {!e.baseline && Object.keys(e.registers).length === 0 && <p>No list changed.</p>}
    </section>
  ))}
</Base>
