---
import Base from "../../../../layouts/Base.astro";
import RegCell from "../../../../components/RegCell.astro";
import RegLegend from "../../../../components/RegLegend.astro";
import { byBrand, COUNTRIES, RC, SNAP_DATE, anchor, trustOf, v1BrandSlugs, type Device } from "../../../../lib/registers";
import { REPO } from "../../../../lib/data";

export function getStaticPaths() {
  return byBrand.map(([b, ds]) => ({ params: { b }, props: { b, ds } }));
}
const { b, ds } = Astro.props as { b: string; ds: Device[] };
const lc = (s: string) => s.toLowerCase();
const sorted = [...ds].sort((x, y) => (lc(x.model) < lc(y.model) ? -1 : lc(x.model) > lc(y.model) ? 1 : 0));
const brand = sorted[0].brand;
const groups = Object.keys(RC).map((c) => [c, sorted.filter((d) => d.cls === c)] as const).filter(([, g]) => g.length);
const listed = COUNTRIES.filter((c) => ds.some((d) => d.cells[c]));
const v1 = v1BrandSlugs.has(b) ? b : "";
---
<Base title={`${brand} in EU grid registers (${listed.join(", ")})`} current="/registers/"
      description={`${ds.length} ${brand} inverters, batteries and chargers across the national grid-connection lists of ${listed.join(", ")}: each list's status, firmware and dates side by side.`}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/registers/">Grid registers</a></nav>
  <header class="head">
    <h1>{brand} in EU grid registers</h1>
    <p class="kind"><span>{ds.length} model{ds.length === 1 ? "" : "s"}</span><span aria-hidden="true">·</span><span>in {listed.join(", ")}</span>
      {v1 && <><span aria-hidden="true">·</span><a href={`/${v1}/`}>local control with Home Assistant and evcc</a></>}</p>
  </header>
  <div class="sec">
    <p class="note">The register is the authority; this is a cross-reference. Empty = no matching entry found, never “not approved”.
      A model name links to a page with every list's details when it is in two or more lists. Hover a cell for the list's own words. All rows seen {SNAP_DATE}.</p>
    <RegLegend />
  </div>
  {groups.map(([cls, g]) => (
    <section class="sec">
      <header><h2>{RC[cls]}</h2><p>{g.length}</p></header>
      <table class="xv">
        <thead><tr><th scope="col">Model</th>{COUNTRIES.map((c) => <th scope="col"><a href={`/registers/country/${c.toLowerCase()}/`}>{c}</a></th>)}<th scope="col" class="match">Match</th></tr></thead>
        <tbody>
          {g.map((d) => (
            <tr id={`m-${anchor(d)}`}>
              <td>{d.page ? <a href={`${d.slug}/`}>{d.model}</a> : d.model}</td>
              {COUNTRIES.map((c) => <RegCell c={c} cell={d.cells[c]} />)}
              <td class="match">{trustOf(d)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
  <p class="sec small muted">A small number after a symbol = the list has several rows for this model (variants, firmware versions); the model page shows each.
    Something wrong? <a href={`${REPO}/issues/new?title=${encodeURIComponent("Registers: " + brand)}`}>Open an issue</a>.</p>
</Base>
