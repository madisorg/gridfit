---
// Home: the two kinds first, then the search, then the two doors (one database, two lenses) and the latest
// changes from both. No JavaScript: the search submits to /local/.
import Base from "../layouts/Base.astro";
import { data, TAGLINE, DATA } from "../lib/data";
import { COUNTRIES, LOG, META, SNAP_DATE } from "../lib/registers";
import { COUNTS, nf } from "../lib/devices";
import { COUNTRIES_ALL } from "../lib/countries";
import { readFileSync } from "node:fs";
const INV = ["inverter", "hybrid", "battery", "plug-in"];
const nInv = data.families.filter((f) => INV.includes(f.class)).length, nEv = data.families.filter((f) => f.class === "wallbox").length;
const dlog: any[] = JSON.parse(readFileSync(DATA + "dataset/changelog.json", "utf-8"));
const d0 = dlog[0], r0 = LOG[0];
const listed = COUNTRIES_ALL.filter((c) => c.list === "yes").length;
const latestList = Object.values(META).map((m) => m.source_date || "").sort().pop();
---
<Base>
  <section class="ask" aria-labelledby="q-h">
    <h1 id="q-h" class="vh">{TAGLINE}</h1>
    <div class="kind hero" role="group" aria-label="Device kind">
      <a href="/local/?g=inv">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M6 12c1.5-3 3-3 4.5 0s3 3 4.5 0 2-2 3 0"/></svg>
        Inverters <b>{nInv}</b></a>
      <a href="/local/?g=ev">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="11" height="16" rx="1"/><path d="M8.5 7h4M8.5 10h4M16 11h2.5v5a2 2 0 0 1-2 2H14"/><path d="M10.5 19v2"/></svg>
        Wallboxes <b>{nEv}</b></a>
    </div>
    <form class="search" role="search" action="/local/" method="get">
      <label class="vh" for="q">Model code, brand or family</label>
      <input id="q" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Model code, brand or family — e.g. SUN-12K-SG04LP3, Wattpilot">
    </form>
    <p class="lede">One database, two questions. Every device page answers both; the two views below start from one or the other. Every row links to its source.</p>
    <div class="doors">
      <a class="door" href="/local/"><b>Local control</b>
        <span>Does it work with Home Assistant and evcc without the cloud — read, or control?</span>
        <span class="facts"><span><b>{nf(COUNTS.families)}</b> families</span><span><b>{nf(COUNTS.rows)}</b> integration rows</span><span><b>{nf(COUNTS.localRoute)}</b> with a local route</span></span></a>
      <a class="door" href="/grid/"><b>Grid lists</b>
        <span>Is the model on a national grid-connection list — and what applies where there is none?</span>
        <span class="facts"><span><b>{nf(COUNTS.regModels)}</b> models</span><span><b>{COUNTRIES.length}</b> lists read</span><span><b>{COUNTRIES_ALL.length}</b> countries, <b>{listed}</b> with a public list</span></span></a>
    </div>
    <p class="facts"><span><b>{nf(COUNTS.brands)}</b> brands</span><span>sources read <b>{data.seen}</b></span><span>lists dated up to <b>{latestList}</b></span>
      <span><a href="/changes/">latest changes</a>: lists {r0.date}{r0.baseline ? " (baseline)" : ""} · rows {d0.date} ({d0.added.length} added, {d0.changed.length} changed)</span></p>
  </section>
</Base>
