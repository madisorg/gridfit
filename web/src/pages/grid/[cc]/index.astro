---
// /grid/{cc}/ — the country view: the grid table preselected to this country, what applies per device class,
// and — for the 7 parsed lists — the list's facts, rows by class, status words and changes. Only the countries the
// site covers get a page; the others answer 301 to /grid/ (web/public/_redirects).
import Base from "../../../layouts/Base.astro";
import Ext from "../../../components/Ext.astro";
import GridView from "../../../components/GridView.astro";
import { devices, COUNTRIES, REGS, RC, META, LOG, STATS, SNAP_DATE, regsOf } from "../../../lib/registers";
import { IN_SCOPE, LIST_WORD, LIST_LONG, CLASS_WORD, CLASS_LONG, CONF_WORD, COUNTRIES_SOURCE, type Country } from "../../../lib/countries";
import { BRANDS, brandSlugOf, nf } from "../../../lib/devices";
import { PROFILES } from "../../../lib/profiles";
import { docsFor } from "../../../lib/evidence";

export function getStaticPaths() {
  return IN_SCOPE.map((c) => ({ params: { cc: c.cc.toLowerCase() }, props: { c } }));
}
const { c } = Astro.props as { c: Country };
const prof = PROFILES[c.cc];
const docs = prof ? docsFor(c.cc) : [];
const cc = c.cc;
const parsed = COUNTRIES.includes(cc);
const here = parsed ? devices.filter((d) => !d.unmatched && d.cells[cc]) : [];
const s = parsed ? STATS[cc] : null;
const byClass = Object.entries(here.reduce((m, d) => ((m[d.cls] = (m[d.cls] ?? 0) + 1), m), {} as Record<string, number>)).sort((a, b) => b[1] - a[1]);
const elsewhere = here.filter((d) => d.n >= 2).length;
const top = Object.entries(here.reduce((m, d) => ((m[brandSlugOf(d)] = (m[brandSlugOf(d)] ?? 0) + 1), m), {} as Record<string, number>))
  .sort((a, b) => b[1] - a[1]).slice(0, 20);
const brandName = new Map(BRANDS.map((b) => [b.slug, b.name]));
const CLASSES = ["inverter", "hybrid", "battery", "plug-in", "wallbox"];
const CLASS_LABEL: Record<string, string> = { inverter: "PV inverter", hybrid: "Hybrid inverter", battery: "Battery / AC inverter", "plug-in": "Plug-in solar / battery (≤ 800 VA)", wallbox: "Wallbox / EV charger" };
// a partial list that is not the grid operator's (Italy: a trade association's members list) is not what the page asks about
const hasList = parsed || c.list === "yes" || (c.list === "partial" && !(prof && !prof.list));
const title = parsed ? `${c.country}: is it on the ${REGS[cc].short}?`
  : prof?.norm ? `${prof.norm} in ${c.country}: is my inverter fit for the grid?` : `${c.country}: is it fit for the grid?`;
const desc = parsed
  ? `${nf(here.length)} inverters, batteries${cc === "AT" ? ", chargers" : ""} on ${c.country}'s grid-connection list, with phases, rated power and the other EU lists side by side; who publishes the list, what it contains, how it changes.`
  : prof?.description ?? `${c.country}: ${LIST_LONG[c.list]} What applies per device class, and every model's status on the other EU lists.`;
---
<Base title={title} current="/grid/" description={desc} noindex={!parsed && !prof} nav="bottom">
  <header class="ask ask-top" aria-labelledby="q-h">
    <h1 id="q-h"><span class="q-inv">Is my inverter fit for {hasList ? `the grid operator's list in ${c.country}` : `the grid in ${c.country}`}?</span><span class="q-ev">Is my wallbox fit for the grid in {c.country}?</span></h1>
    <div class="kind kind-icons" role="group" aria-label="Device kind" data-for="gv">
      <button type="button" data-g="inv" aria-pressed="true" title="Inverters, hybrids, batteries"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1"/><path d="M6 12c1.5-3 3-3 4.5 0s3 3 4.5 0 2-2 3 0"/></svg><span>Inverters</span></button>
      <button type="button" data-g="ev" aria-pressed="false" title="Wallboxes and EV chargers"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="3" width="11" height="16" rx="1"/><path d="M8.5 7h4M8.5 10h4M16 11h2.5v5a2 2 0 0 1-2 2H14"/><path d="M10.5 19v2"/></svg><span>Wallboxes</span></button>
    </div>
  </header>
  <GridView preset={cc} kind="inv" kindAt="top" />

  <section class="sec" id="list">
    <header><h2>{c.country}: {LIST_WORD[c.list]}</h2>
      <p>{parsed && s ? `${nf(s.rows)} rows · ${nf(here.length)} models · ${nf(elsewhere)} also on another country's list` : ""}{c.list_url && <> · <Ext href={c.list_url}>the list</Ext></>}</p></header>
    <p class="prose small muted">{LIST_LONG[c.list]}{!parsed && c.list === "yes" ? " GridFit has not read this list yet; the table above shows the models of the lists it has read, with what applies here." : ""}</p>
  </section>

  <section class="sec">
    <header><h2>What applies per device class</h2><p>{COUNTRIES_SOURCE}</p></header>
    <table class="tbl">
      <thead><tr><th scope="col">Device class</th><th scope="col">What applies</th><th scope="col">Checked</th></tr></thead>
      <tbody>{CLASSES.map((k) => <tr><td class="fam">{CLASS_LABEL[k]}</td><td data-l=""><b>{CLASS_WORD[c.classes[k]]}</b> <span class="muted">— {CLASS_LONG[c.classes[k]]}</span></td><td data-l="checked" class="muted">{CONF_WORD[c.confidence[k]] ?? c.confidence[k]}</td></tr>)}</tbody>
    </table>
    {!parsed && !prof && <p class="small muted">Country notes — who files the application, what the certificate must say, how a model gets onto the list, thresholds and deadlines — are being written.</p>}
  </section>

  {prof && (
    <section class="sec" id="how">
      <header><h2>How it works in {c.country}{prof.norm && `: ${prof.norm}`}</h2><p>from {prof.decided_by.split(" (")[0].replace(/^The /, "the ")}'s own documents · the grid operator decides</p></header>
      {prof.summary && <p class="prose">{prof.summary}</p>}
      <dl class="facts-dl panel">
        <dt>Who decides</dt><dd>{prof.decided_by}</dd>
        {prof.list && <><dt>The list</dt><dd><Ext href={prof.list.url}>{prof.list.name}</Ext> — {prof.list.meaning}</dd>
          <dt>Is it a gate?</dt><dd>{prof.list.gate}</dd></>}
        <dt>Basis</dt><dd><ul class="small">{prof.basis.map((b) => <li>{b}</li>)}</ul></dd>
        <dt>Thresholds</dt><dd><ul class="small">{prof.thresholds.map((t) => <li>{t}</li>)}</ul></dd>
        {prof.commissioning && <><dt>Before switching on</dt><dd>{prof.commissioning}</dd></>}
        {prof.changes && <><dt>What changes</dt><dd><ul class="small">{prof.changes.map((t) => <li>{t}</li>)}</ul></dd></>}
      </dl>
      <h3>What the model must meet</h3>
      <table class="tbl">
        <thead><tr><th scope="col">Requirement</th><th scope="col">Value</th></tr></thead>
        <tbody>{prof.must_meet.map((m) => <tr><td class="fam">{m.rule}</td><td data-l="">{m.value}</td></tr>)}</tbody>
      </table>
      <h3>{prof.list ? "How a model gets onto the list" : "How a model is accepted"}</h3>
      <p class="prose small">{prof.apply?.who ? `Who applies: ${prof.apply.who}. ` : ""}{prof.apply?.how}{prof.apply?.guide_url && <> — <Ext href={prof.apply.guide_url}>{prof.list ? "the listing guide" : "the operator’s guide"}</Ext>{prof.apply.guide_date ? ` (${prof.apply.guide_date})` : ""}</>}{prof.apply?.processing_time ? `. Processing time: ${prof.apply.processing_time}.` : ""}</p>
      <ul class="prose small">{prof.documents_for_listing.map((d) => <li>{d}</li>)}</ul>
      {prof.not_listed && <><h3>{prof.list ? "If the model is not on the list" : "If the model has no certificate"}</h3><p class="prose small">{prof.not_listed}</p></>}
      {prof.evidence_for_documented && <><h3>What GridFit will show as “fit by the maker's document”</h3><p class="prose small">{prof.evidence_for_documented}</p></>}
      {docs.length > 0 && <>
        <h3>The makers' documents read so far</h3>
        <table class="tbl">
          <thead><tr><th scope="col">Brand and families</th><th scope="col">Document</th></tr></thead>
          <tbody>{docs.map((x) => { const slug = BRANDS.find((b) => b.name === x.brand)?.slug; return (
            <tr><td class="fam">{slug ? <a href={`/${slug}/`}>{x.brand}</a> : x.brand} <span class="muted">— {x.families.join("; ")}</span></td>
              <td data-l=""><Ext href={x.doc.url}>{(x.doc.cert_no ?? x.doc.kind).split(" (")[0]}</Ext>{x.doc.issuer ? ` · ${x.doc.issuer.split(" (")[0]}` : ""}{x.doc.issued ? ` · ${x.doc.issued}` : ""}{x.doc.standards?.length ? <span class="muted"> · {x.doc.standards.at(-1)}</span> : ""}</td></tr>); })}</tbody>
        </table>
      </>}
      <h3>Sources</h3>
      <ul class="prose small">{prof.sources.map((x) => <li><Ext href={x.url}>{x.title}</Ext>{x.date ? ` (${x.date})` : ""}{x.seen ? `, read ${x.seen}` : ""}</li>)}</ul>
    </section>
  )}
  {parsed && s && regsOf(cc).map((r) => {
    const x = REGS[r], m = META[r] ?? {};
    return (
      <section class="sec">
        <header><h2><Ext href={x.url}>{x.name}</Ext></h2></header>
        <dl class="facts-dl panel">
          <dt>Published by</dt><dd>{x.operator}</dd>
          <dt>Basis</dt><dd>{x.basis}</dd>
          <dt>Is it a gate?</dt><dd>{x.gate}</dd>
          <dt>What it contains</dt><dd>{x.contains}</dd>
          <dt>Reuse terms</dt><dd>{x.terms}</dd>
          <dt>What we show</dt><dd>{x.use}.</dd>
          <dt>List dated</dt><dd>{m.source_date || "—"}</dd>
          <dt>Downloaded</dt><dd>{m.seen || SNAP_DATE}{m.carried_over && " (not reachable at the last refresh; previous rows kept)"}</dd>
          <dt>Rows read</dt><dd>{nf(m.rows ?? 0)}{m.unread_lp?.length ? ` — ${m.unread_lp.length} rows of the PDF could not be read (Lp ${m.unread_lp.join(", ")}); they are not shown` : ""}</dd>
        </dl>
      </section>
    );
  })}
  {parsed && s && (
    <section class="sec">
      <header><h2>In numbers</h2></header>
      <p class="prose">{nf(s.rows)} rows; {nf(here.length)} inverters, batteries, plug-in units and chargers after joining spellings, of which
        <strong>{nf(elsewhere)}</strong> also appear in at least one other country's list.
        {s.other_rows > 0 && ` ${nf(s.other_rows)} further rows are CHP units, generators, wind turbines, relays and similar — kept in the data, without pages.`}</p>
      <table class="tbl">
        <thead><tr><th scope="col">Device class</th><th scope="col" class="num">Models</th></tr></thead>
        <tbody>{byClass.map(([k, n]) => <tr><td class="fam">{RC[k]}</td><td class="num" data-l="models">{nf(n)}</td></tr>)}</tbody>
      </table>
      {cc !== "BE" && (
        <>
          <h3>Status words, as the list writes them</h3>
          <table class="tbl">
            <thead><tr><th scope="col">Word</th>{s.regs.length > 1 && <th scope="col">List</th>}<th scope="col" class="num">Rows</th></tr></thead>
            <tbody>{s.words.map(([r, w, n]) => <tr><td class="fam" lang={cc === "AT" ? "de" : undefined}>{w}</td>{s.regs.length > 1 && <td data-l="">{REGS[r].short}</td>}<td class="num" data-l="rows">{nf(n)}</td></tr>)}</tbody>
          </table>
        </>
      )}
    </section>
  )}
  {parsed && top.length > 0 && (
    <section class="sec">
      <header><h2>Brands with the most models here</h2></header>
      <p class="brand-list">{top.map(([b, n]) => <a href={`/${b}/#grid`}>{brandName.get(b) ?? b} <span class="muted">{n}</span></a>)}</p>
    </section>
  )}
  {parsed && s && (
    <section class="sec">
      <header><h2>Changes in this list</h2></header>
      <ul class="small">
        {LOG.map((e) => {
          const rs = Object.entries(e.registers).filter(([r]) => s.regs.includes(r)) as [string, any][];
          return e.baseline ? <li>{e.date} — baseline.</li> : rs.length ? rs.map(([r, x]) => (
            <li>{e.date} — list dated {x.source_date}: {x.added.length} added, {x.removed.length} removed, {x.changed.length} changed
              (<a href={`/changes/#${e.date}-${r}`}>details</a>)</li>
          )) : <li>{e.date} — no change.</li>;
        })}
      </ul>
    </section>
  )}
  <section class="sec">
    <header><h2>Other countries</h2></header>
    <p class="brand-list">{IN_SCOPE.filter((o) => o.cc !== cc).map((o) => <a href={`/grid/${o.cc.toLowerCase()}/`}>{o.cc} <span class="muted">{o.country}</span></a>)}</p>
  </section>
</Base>
